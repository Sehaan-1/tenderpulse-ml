{
 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# 01 – Exploratory Data Analysis\n",
    "\n",
    "Understand what's actually in the raw eProcure data before touching any model.\n",
    "\n",
    "* Field completeness\n",
    "* Title language (Devanagari detection)\n",
    "* Title extraction sanity (Phase 1 regression check)\n",
    "* Title length distribution\n",
    "* Organization frequency\n",
    "* Date range\n",
    "\n",
    "**If `extract_title()` fails on ≥5 % of records → fix Phase 1 before proceeding.**"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import json\n",
    "import os\n",
    "import re\n",
    "import sys\n",
    "from collections import Counter\n",
    "from datetime import datetime\n",
    "from pathlib import Path\n",
    "\n",
    "import matplotlib.pyplot as plt\n",
    "import pandas as pd\n",
    "\n",
    "project_root = Path().resolve().parent\n",
    "sys.path.insert(0, str(project_root / 'src'))\n",
    "from title_cleaner import extract_title\n",
    "\n",
    "DATA_PATH = project_root / 'data' / 'raw' / 'tenders.jsonl'\n",
    "print(f'Data file exists: {DATA_PATH.exists()}')\n",
    "print(f'Python: {sys.version[:50]}')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Load all records\n",
    "records = []\n",
    "with DATA_PATH.open('r', encoding='utf-8') as fh:\n",
    "    for line in fh:\n",
    "        line = line.strip()\n",
    "        if line:\n",
    "            records.append(json.loads(line))\n",
    "\n",
    "print(f'Total records loaded: {len(records)}')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 1. Field Completeness"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "df = pd.DataFrame(records)\n",
    "completeness = df.notna().sum().sort_values(ascending=False)\n",
    "completeness_pct = (completeness / len(df) * 100).round(1)\n",
    "\n",
    "comp_df = pd.DataFrame({'non_null': completeness, 'pct': completeness_pct})\n",
    "print(comp_df)\n",
    "print(f\"\\nFields with <50% completion: {comp_df[comp_df['pct'] < 50].index.tolist()}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2. Title Language Detection (Devanagari)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "devanagari_re = re.compile(r'[\u0900-\u097F]')\n",
    "\n",
    "devanagari_count = 0\n",
    "devanagari_examples = []\n",
    "\n",
    "for rec in records:\n",
    "    title = rec.get('title', '')\n",
    "    if devanagari_re.search(title):\n",
    "        devanagari_count += 1\n",
    "        if len(devanagari_examples) < 5:\n",
    "            devanagari_examples.append(title[:120])\n",
    "\n",
    "print(f'Devanagari-containing titles: {devanagari_count} / {len(records)} ({devanagari_count/len(records)*100:.1f}%)')\n",
    "print('Examples (first 5):')\n",
    "for ex in devanagari_examples:\n",
    "    print(f'  → {ex}')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 3. Title Extraction Sanity Check"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "failures = []\n",
    "empty_titles = []\n",
    "no_ref_count = 0\n",
    "\n",
    "for rec in records:\n",
    "    raw = rec.get('title', '')\n",
    "    try:\n",
    "        title, ref = extract_title(raw)\n",
    "        if not title.strip():\n",
    "            empty_titles.append(rec.get('tender_id'))\n",
    "        if ref is None:\n",
    "            no_ref_count += 1\n",
    "    except Exception as exc:\n",
    "        failures.append((rec.get('tender_id'), raw[:100], str(exc)))\n",
    "\n",
    "failure_pct = len(failures) / len(records) * 100\n",
    "print(f'Total records: {len(records)}')\n",
    "print(f'extract_title() failures: {len(failures)} ({failure_pct:.1f}%)')\n",
    "print(f'Empty extracted titles: {len(empty_titles)}')\n",
    "print(f'No reference found: {no_ref_count} ({no_ref_count/len(records)*100:.1f}%)')\n",
    "\n",
    "if failure_pct >= 5:\n",
    "    print(f'\\n⚠ REGRESSION: {failure_pct:.1f}% failure rate >= 5%. Phase 1 needs fixing.')\n",
    "else:\n",
    "    print(f'\\n✅ PASS: {failure_pct:.1f}% failure rate < 5%. Phase 1 is solid.')\n",
    "\n",
    "if failures:\n",
    "    print(f'\\nFirst 3 failures:')\n",
    "    for f in failures[:3]:\n",
    "        print(f'  {f[0]}: {f[1]}... → {f[2]}')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 4. Title Length Distribution"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "title_lengths = []\n",
    "word_counts = []\n",
    "\n",
    "for rec in records:\n",
    "    try:\n",
    "        title, _ = extract_title(rec.get('title', ''))\n",
    "        title_lengths.append(len(title))\n",
    "        word_counts.append(len(title.split()))\n",
    "    except Exception:\n",
    "        pass\n",
    "\n",
    "fig, axes = plt.subplots(1, 2, figsize=(14, 4))\n",
    "\n",
    "axes[0].hist(title_lengths, bins=50, edgecolor='black')\n",
    "axes[0].set_xlabel('Characters')\n",
    "axes[0].set_ylabel('Frequency')\n",
    "axes[0].set_title(f'Title Length (chars): μ={sum(title_lengths)/len(title_lengths):.0f}, median={sorted(title_lengths)[len(title_lengths)//2]}')\n",
    "axes[0].axvline(x=500, color='red', linestyle='--', label='500 char threshold')\n",
    "axes[0].legend()\n",
    "\n",
    "axes[1].hist(word_counts, bins=40, edgecolor='black')\n",
    "axes[1].set_xlabel('Words')\n",
    "axes[1].set_ylabel('Frequency')\n",
    "axes[1].set_title(f'Word Count: μ={sum(word_counts)/len(word_counts):.1f}, median={sorted(word_counts)[len(word_counts)//2]}')\n",
    "axes[1].axvline(x=50, color='red', linestyle='--', label='50 word threshold')\n",
    "axes[1].legend()\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "# stats\n",
    "print(f'Character stats: min={min(title_lengths)}, max={max(title_lengths)}')\n",
    "print(f'Word stats: min={min(word_counts)}, max={max(word_counts)}')\n",
    "print(f'Titles >500 chars: {sum(1 for t in title_lengths if t > 500)}')\n",
    "print(f'Titles >50 words: {sum(1 for t in word_counts if t > 50)}')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 5. Organization Frequency"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "org_counts = Counter()\n",
    "for rec in records:\n",
    "    org = rec.get('org_chain', '')\n",
    "    # First organization in the chain\n",
    "    if org:\n",
    "        first_org = org.split('||')[0].strip()\n",
    "        org_counts[first_org] += 1\n",
    "\n",
    "print('Top 10 organizations:')\n",
    "for org, count in org_counts.most_common(10):\n",
    "    print(f'  {count:>4} — {org}')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 6. Date Range"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "dates = []\n",
    "for rec in records:\n",
    "    pd_str = rec.get('published_date')\n",
    "    if pd_str:\n",
    "        try:\n",
    "            dates.append(datetime.fromisoformat(pd_str))\n",
    "        except ValueError:\n",
    "            pass\n",
    "\n",
    "if dates:\n",
    "    print(f'Oldest: {min(dates).strftime(\"%Y-%m-%d\")}')\n",
    "    print(f'Newest: {max(dates).strftime(\"%Y-%m-%d\")}')\n",
    "    print(f'Days spanned: {(max(dates) - min(dates)).days}')\n",
    "else:\n",
    "    print('No valid dates found.')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Summary"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "print(f\"\"\"\n",
    "=== EDA Summary ===\n",
    "Total records: {len(records)}\n",
    "extract_title() failure rate: {failure_pct:.1f}% {'✅ PASS' if failure_pct < 5 else '⚠ REGRESSION'}\n",
    "Devanagari titles: {devanagari_count} / {len(records)} ({devanagari_count/len(records)*100:.1f}%)\n",
    "Field completeness worst: {comp_df['pct'].min():.1f}% ({comp_df['pct'].idxmin()})\n",
    "Title length (chars): {min(title_lengths)} — {max(title_lengths)} (μ {sum(title_lengths)//len(title_lengths)})\n",
    "Top org: {org_counts.most_common(1)[0][0]} ({org_counts.most_common(1)[0][1]})\n",
    "Date range: {min(dates).strftime('"'"'%Y-%m-%d'"'"') if dates else 'N/A'} to {max(dates).strftime('"'"'%Y-%m-%d'"'"') if dates else 'N/A'}\n",
    "\"\"\")"
   ]
  }
 ],
